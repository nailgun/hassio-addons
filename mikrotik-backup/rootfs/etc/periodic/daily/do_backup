#!/usr/bin/with-contenv bashio

set -euo pipefail

function _ssh() {
    ssh -n "$@" | sed s/.$//
}

# Restore known_hosts file, symlink on this file doesn't work for some reason
cp /data/known_hosts ~/.ssh/known_hosts

bashio::log.info "Pulling repo changes..."
git -C "/data/repo" pull --no-rebase

if bashio::config.true "include_sensitive"; then
  export_cmd="/export show-sensitive"
else
  export_cmd="/export"
fi

ssh_host_args="$(bashio::config ssh_host_args)"

while read -r host_args; do
  bashio::log.info "SSH: $host_args"

  # shellcheck disable=SC2086
  ident="$(_ssh $host_args 'put [/system identity print as-value]' || true)"
  if [[ -z "$ident" ]]; then
      bashio::log.warning "Failed to connect"
      continue
  fi
  if [[ ! "$ident" =~ ^name=(.*)$ ]]; then
      bashio::log.warning "Invalid identity output: '$ident'"
      continue
  fi
  ident="${BASH_REMATCH[1]}"

  bashio::log.info "  ident: $ident"

  # shellcheck disable=SC2086
  export_file="$(mktemp)"
  if ! _ssh $host_args $export_cmd | sed '1 s/#.* by/# by/' > "$export_file"; then
    bashio::log.warning "Export failed for $ident; keeping previous configuration"
    rm -f "$export_file"
    continue
  fi
  if ! awk '/^[[:space:]]*\/[[:alnum:]_]/ { found=1 } END { exit !found }' "$export_file"; then
    bashio::log.warning "Empty or header-only export for $ident; keeping previous configuration"
    rm -f "$export_file"
    continue
  fi
  mv "$export_file" "/data/repo/mikrotik/$ident.rsc"

  git -C "/data/repo" add "/data/repo/mikrotik/$ident.rsc"
  git -C "/data/repo" commit --message="Mikrotik backup: $ident" || true
done <<< "$ssh_host_args"

bashio::log.info "Pushing repo..."
git -C "/data/repo" push

# Save known_hosts file
cp ~/.ssh/known_hosts /data/known_hosts
